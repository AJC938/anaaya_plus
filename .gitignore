.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated localization output (regenerated by `flutter gen-l10n` / `flutter pub get`)
/lib/core/localization/app_localizations*.dart
/untranslated.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# SPG-07: the Supabase CLI, installed as a root devDependency
# (`npm install -D supabase`) so it can run via `npx supabase` — this is
# tooling only, not an app dependency, but it still creates a real
# node_modules/ at the project root that must never be committed.
/node_modules/
npm-debug.log*

# SPG-09: the Firebase Admin SDK service-account key, staged here only
# temporarily to load into a Supabase secret via `supabase secrets set` —
# never meant to stay on disk, never meant to be committed. Delete the
# actual file once the secret is confirmed set.
/firebase-service-account.json

# Manual-testing debug scratch — ad hoc `flutter run`/ADB screenshots,
# logcat dumps, and UI-hierarchy XML captured during feature verification.
# Useful in the moment, never meant to be committed or kept long-term.
/.screenshots/
/.run_log.txt
*.webm
